From f11b488316a37c8f13de7e260b46f018771e6af4 Mon Sep 17 00:00:00 2001
From: yonglunyao <yonglunyao@gmail.com>
Date: Sat, 3 Oct 2026 14:41:23 +0800
Subject: [PATCH 6/6] platform/arm64: huawei-gaokun-ec: adapt to 6.6 kernel
 APIs

Three mechanical fixes so the EC and battery drivers compile on 6.6:

- huawei-gaokun-ec.c: kzalloc_obj() does not exist in 6.6, use plain
  kzalloc(sizeof(*adev), GFP_KERNEL).
- huawei-gaokun-battery.c: power_supply_config.no_wakeup_source was
  added upstream later; register both power supplies with
  devm_power_supply_register_no_ws() to keep the "no wakeup source"
  semantics of the absorbed wakeup-source fix.
- huawei-gaokun-battery.c: struct power_supply_desc.usb_types switched
  from an enum array + num_usb_types to a bitmap upstream; use the
  array form 6.6 still expects.

The UCSI companion driver is left verbatim and must stay disabled
(CONFIG_UCSI_HUAWEI_GAOKUN=n): 6.6 still has the old UCSI core
callback model and no DRM auxiliary HPD bridge; porting it is tracked
as a follow-up.

Co-Authored-By: Claude Code <noreply@anthropic.com>
Signed-off-by: yonglunyao <yonglunyao@gmail.com>
---
 drivers/platform/arm64/huawei-gaokun-ec.c    |  2 +-
 drivers/power/supply/huawei-gaokun-battery.c | 20 ++++++++++++++------
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/drivers/platform/arm64/huawei-gaokun-ec.c b/drivers/platform/arm64/huawei-gaokun-ec.c
index e9c4e72473c1..578e75b74076 100644
--- a/drivers/platform/arm64/huawei-gaokun-ec.c
+++ b/drivers/platform/arm64/huawei-gaokun-ec.c
@@ -697,7 +697,7 @@ static int gaokun_aux_init(struct device *parent, const char *name,
 	struct auxiliary_device *adev;
 	int ret;
 
-	adev = kzalloc_obj(*adev);
+	adev = kzalloc(sizeof(*adev), GFP_KERNEL); /* 6.6: no kzalloc_obj() yet */
 	if (!adev)
 		return -ENOMEM;
 
diff --git a/drivers/power/supply/huawei-gaokun-battery.c b/drivers/power/supply/huawei-gaokun-battery.c
index 6212b0068d44..506fca2f2989 100644
--- a/drivers/power/supply/huawei-gaokun-battery.c
+++ b/drivers/power/supply/huawei-gaokun-battery.c
@@ -170,10 +170,16 @@ static enum power_supply_property gaokun_psy_adp_props[] = {
 	POWER_SUPPLY_PROP_USB_TYPE,
 };
 
+/* 6.6: usb_types is an enum array + num_usb_types, not a bitmap yet */
+static enum power_supply_usb_type gaokun_psy_adp_usb_types[] = {
+	POWER_SUPPLY_USB_TYPE_C,
+};
+
 static const struct power_supply_desc gaokun_psy_adp_desc = {
 	.name		= "gaokun-ec-adapter",
 	.type		= POWER_SUPPLY_TYPE_USB,
-	.usb_types	= BIT(POWER_SUPPLY_USB_TYPE_C),
+	.usb_types	= gaokun_psy_adp_usb_types,
+	.num_usb_types	= ARRAY_SIZE(gaokun_psy_adp_usb_types),
 	.get_property	= gaokun_psy_get_adp_property,
 	.properties	= gaokun_psy_adp_props,
 	.num_properties	= ARRAY_SIZE(gaokun_psy_adp_props),
@@ -613,9 +619,11 @@ static int gaokun_psy_probe(struct auxiliary_device *adev,
 	auxiliary_set_drvdata(adev, ecbat);
 
 	psy_cfg.drv_data = ecbat;
-	psy_cfg.no_wakeup_source = true;
-	ecbat->adp_psy = devm_power_supply_register(dev, &gaokun_psy_adp_desc,
-						    &psy_cfg);
+	/* 6.6: power_supply_config has no no_wakeup_source; use the _no_ws
+	 * variant instead (upstream semantics after the wakeup-source fix).
+	 */
+	ecbat->adp_psy = devm_power_supply_register_no_ws(dev, &gaokun_psy_adp_desc,
+							  &psy_cfg);
 	if (IS_ERR(ecbat->adp_psy))
 		return dev_err_probe(dev, PTR_ERR(ecbat->adp_psy),
 				     "Failed to register AC power supply\n");
@@ -623,8 +631,8 @@ static int gaokun_psy_probe(struct auxiliary_device *adev,
 	psy_cfg.supplied_to = (char **)&gaokun_psy_bat_desc.name;
 	psy_cfg.num_supplicants = 1;
 	psy_cfg.attr_grp = gaokun_psy_features_groups;
-	ecbat->bat_psy = devm_power_supply_register(dev, &gaokun_psy_bat_desc,
-						    &psy_cfg);
+	ecbat->bat_psy = devm_power_supply_register_no_ws(dev, &gaokun_psy_bat_desc,
+							  &psy_cfg);
 	if (IS_ERR(ecbat->bat_psy))
 		return dev_err_probe(dev, PTR_ERR(ecbat->bat_psy),
 				     "Failed to register battery power supply\n");
-- 
